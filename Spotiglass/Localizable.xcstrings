    "playback.nowPlaying": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now playing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduciendo ahora"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gerade wiedergegeben"
