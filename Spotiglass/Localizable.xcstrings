    "playback.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback paused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducción en pausa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe pausiert"
          }
        }
      }
    },
    "app.connection.signedOut.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify is not connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify no está conectado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ist nicht verbunden"
          }
        }
      }
    },
    "app.connection.signedOut.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Spotify client ID, then connect your Spotify account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu ID de cliente de Spotify y conecta tu cuenta de Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Spotify-Client-ID ein und verbinde dann dein Spotify-Konto."
          }
        }
      }
    },
    "app.connection.signingIn.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Spotify sign-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriendo inicio de sesión de Spotify"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Anmeldung wird geöffnet"
          }
        }
      }
    },
    "app.connection.signingIn.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete authorization in the browser window. Spotiglass is listening on 127.0.0.1 for the callback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la autorización en la ventana del navegador. Spotiglass escucha en 127.0.0.1 el callback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Autorisierung im Browserfenster ab. Spotiglass lauscht auf 127.0.0.1 auf den Callback."
          }
        }
      }
    },
    "app.connection.signedIn.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify is connected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify está conectado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ist verbunden"
          }
        }
      }
    },
    "app.connection.signedIn.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access token is valid until %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token de acceso es válido hasta %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zugriffstoken ist gültig bis %@."
          }
        }
      }
    },
    "app.connection.refreshing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing Spotify session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizando sesión de Spotify"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Sitzung wird aktualisiert"
          }
        }
      }
    },
    "app.connection.refreshing.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass is refreshing the stored Spotify session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass está actualizando la sesión de Spotify almacenada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass aktualisiert die gespeicherte Spotify-Sitzung."
          }
        }
      }
    },
    "app.connection.failed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify sign-in needs attention"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de Spotify requiere atención"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Anmeldung erfordert Aufmerksamkeit"
          }
        }
      }
    },
    "auth.connect.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Spotify"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar Spotify"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify verbinden"
          }
        }
      }
    },
    "auth.connect.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts Spotify sign-in using the configured client ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el inicio de sesión de Spotify con el ID de cliente configurado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Spotify-Anmeldung mit der konfigurierten Client-ID."
          }
        }
      }
    },
    "auth.cancel.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "auth.cancel.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops waiting for the browser sign-in and returns to the welcome screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de esperar el inicio de sesión en el navegador y vuelve a la pantalla de bienvenida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet das Warten auf die Browser-Anmeldung und kehrt zum Willkommensbildschirm zurück."
          }
        }
      }
    },
    "auth.disconnect.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trennen"
          }
        }
      }
    },
    "auth.disconnect.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the current Spotify sign-in state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el estado actual del inicio de sesión de Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den aktuellen Spotify-Anmeldestatus."
          }
        }
      }
    },
    "auth.clientID.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify client ID"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ID de cliente de Spotify"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Client-ID"
          }
        }
      }
    },
    "auth.clientID.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the client ID from your Spotify Developer Dashboard app. Value is hidden until you click or tab into this field."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el ID de cliente de tu app en el Spotify Developer Dashboard. El valor está oculto hasta que hagas clic o entres en este campo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Client-ID aus deiner App im Spotify Developer Dashboard ein. Der Wert ist verborgen, bis du in dieses Feld klickst oder es fokussierst."
          }
        }
      }
    },
    "auth.insufficientScope.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current Spotify session is missing playlist or Liked Songs permissions. Disconnect and connect again to grant required scopes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión actual de Spotify no tiene permisos de listas o Canciones que te gustan. Desconéctate y vuelve a conectar para conceder los permisos necesarios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deiner aktuellen Spotify-Sitzung fehlen Berechtigungen für Playlists oder Liked Songs. Trenne die Verbindung und verbinde dich erneut, um die erforderlichen Bereiche zu gewähren."
          }
        }
      }
    },
    "settings.account.validUntil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid until %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Válido hasta %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültig bis %@"
          }
        }
      }
    },
    "settings.account.developerApp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify developer app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App de desarrollador de Spotify"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify-Entwickler-App"
          }
        }
      }
    },
    "settings.account.developerApp.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Client ID from your app in the Spotify Developer Dashboard. OAuth uses a fixed loopback redirect on 127.0.0.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el ID de cliente de tu app en el Spotify Developer Dashboard. OAuth usa una redirección fija en 127.0.0.1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Client-ID deiner App im Spotify Developer Dashboard. OAuth nutzt eine feste Loopback-Weiterleitung auf 127.0.0.1."
          }
        }
      }
    },
    "settings.appearance.lyricsTextSize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics text size"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del texto de letras"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Textgröße der Songtexte"
          }
        }
      }
    },
    "settings.appearance.lyricsTextSize.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls font size and line spacing in the immersive lyrics view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla el tamaño de fuente y el espaciado entre líneas en la vista inmersiva de letras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert Schriftgröße und Zeilenabstand in der immersiven Songtext-Ansicht."
          }
        }
      }
    },
    "settings.appearance.lyricsPreview.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics preview, %@ size"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de letras, tamaño %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songtext-Vorschau, Größe %@"
          }
        }
      }
    },
    "settings.playback.whenDrops.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When something drops"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando algo falla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn etwas ausfällt"
          }
        }
      }
    },
    "settings.playback.whenDrops.item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Reconnect in the playback bar or run “Connect Playback” from the Command Palette if playback stops or shows an error."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Reconectar en la barra de reproducción o ejecuta «Conectar reproducción» desde la Paleta de comandos si la reproducción se detiene o muestra un error."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „Erneut verbinden“ in der Wiedergabeleiste oder führe „Wiedergabe verbinden“ aus der Befehls-Palette aus, wenn die Wiedergabe stoppt oder einen Fehler anzeigt."
          }
        }
      }
    },
    "settings.playback.sessions.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
