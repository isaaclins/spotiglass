    "settings.appearance.lyricsOffset.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe das Timing der Songtexte an, falls Zeilen zu früh oder zu spät erscheinen. Ziehe in Richtung „Früher“, damit Zeilen eher erscheinen, praktisch, wenn der Text dem Ton etwas hinterherhinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudge lyric timing if lines feel early or late. Drag toward “Earlier” so lines appear sooner, handy when lyrics lag a little behind the audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la sincronización si las líneas aparecen antes o después de tiempo. Arrastra hacia «Antes» para que las líneas aparezcan más pronto, útil cuando la letra va un poco por detrás del audio."
          }
        }
      }
    },
