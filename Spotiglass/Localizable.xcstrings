    "settings.playback.whenDrops.item": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „Erneut verbinden“ in der Wiedergabeleiste oder führe „Wiedergabe verbinden“ aus der Befehls-Palette aus, wenn die Wiedergabe stoppt oder einen Fehler anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use “Reconnect” in the playback bar or run “Connect Playback” from the Command Palette if playback stops or shows an error."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa «Reconectar» en la barra de reproducción o ejecuta «Conectar reproducción» desde la Paleta de comandos si la reproducción se detiene o muestra un error."
          }
        }
      }
    },
    "settings.playback.whenDrops.title": {
