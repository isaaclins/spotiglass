    "palette.settings.hint": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke ein Feld an und drücke ein Tastenkürzel. Esc bricht ab; Entf löscht. Konflikte können die andere Belegung ersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a field and press a shortcut. Esc cancels; Delete clears. Conflicts can replace the other binding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un campo y pulsa un atajo. Esc cancela; Suprimir borra. Los conflictos pueden reemplazar la otra asignación."
          }
        }
      }
    },
