    "error.browsing.followedPlaylistLocked.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify erlaubt Spotiglass nicht mehr, die Songs in Playlists aufzulisten, die dir nicht gehören. Du kannst die ganze Playlist trotzdem abspielen oder sie in Spotify öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify no longer lets Spotiglass list the songs in playlists you do not own. You can still play the whole playlist or open it in Spotify."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ya no permite que Spotiglass muestre las canciones de las listas que no son tuyas. Todavía puedes reproducir la lista completa o abrirla en Spotify."
          }
        }
      }
    },
