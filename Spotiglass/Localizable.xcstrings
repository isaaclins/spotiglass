{
  "sourceLanguage": "en",
  "strings": {
    "settings.section.appearance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apariencia"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung"
          }
        }
      }
    },
    "settings.section.appearance.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual options for Spotiglass windows and overlays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opciones visuales para ventanas y superposiciones de Spotiglass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Visuelle Optionen für Spotiglass-Fenster und Overlays."
          }
        }
      }
    },
