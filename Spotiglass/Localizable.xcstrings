    "settings.playback.sessions.item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one Spotify account is signed in at a time. Disconnect in Account settings to switch accounts or clear the stored session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puede haber una cuenta de Spotify conectada a la vez. Desconéctate en Ajustes de cuenta para cambiar de cuenta o borrar la sesión almacenada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann jeweils nur ein Spotify-Konto angemeldet sein. Trenne die Verbindung in den Kontoeinstellungen, um das Konto zu wechseln oder die gespeicherte Sitzung zu löschen."
          }
        }
      }
    },
    "settings.playback.premium.item1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback uses Spotify’s Web Playback SDK in a hidden web view. Spotify reports an account error for non-Premium accounts; playlist browsing may still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción usa el Web Playback SDK de Spotify en una vista web oculta. Spotify informa de un error de cuenta para cuentas sin Premium; explorar listas puede seguir funcionando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe nutzt Spotifys Web Playback SDK in einer versteckten Webansicht. Spotify meldet einen Kontofehler für Nicht-Premium-Konten; das Durchsuchen von Playlists kann weiterhin funktionieren."
          }
        }
      }
    },
    "settings.playback.premium.item2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you sign in, Spotiglass registers this Mac as a Spotify Connect device automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras iniciar sesión, Spotiglass registra este Mac como dispositivo Spotify Connect automáticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Anmeldung registriert Spotiglass diesen Mac automatisch als Spotify-Connect-Gerät."
          }
        }
      }
    },
