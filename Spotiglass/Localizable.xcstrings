{
  "sourceLanguage": "en",
  "strings": {
    "%@, %@": {
      "comment": "A11y label combining the title and subtitle of a media card.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A column that displays the track number of a song. The argument is the track number.",
      "isCommentAutoGenerated": true,
      "localizations": {
