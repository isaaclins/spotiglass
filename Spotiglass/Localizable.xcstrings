          }
        }
      }
    },
    "settings.playback.sessions.item": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann jeweils nur ein Spotify-Konto angemeldet sein. Trenne die Verbindung in den Kontoeinstellungen, um das Konto zu wechseln oder die gespeicherte Sitzung zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one Spotify account is signed in at a time. Disconnect in Account settings to switch accounts or clear the stored session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puede haber una cuenta de Spotify conectada a la vez. Desconéctate en Ajustes de cuenta para cambiar de cuenta o borrar la sesión almacenada."
          }
        }
      }
    },
    "settings.playback.sessions.title": {
