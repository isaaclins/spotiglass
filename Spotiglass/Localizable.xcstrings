    "settings.playback.intro": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass gibt Audio über Spotifys Web Playback SDK wieder, daher gibt es hier keine lokalen Wiedergabe-Einstellungen. Diese Ansicht erklärt, wie die Wiedergabe funktioniert und wie du sie wiederherstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass plays audio through Spotify’s Web Playback SDK, so there are no local playback controls to configure here. This pane explains how playback works and how to recover it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotiglass reproduce el audio mediante el Web Playback SDK de Spotify, por lo que aquí no hay controles de reproducción locales que configurar. Este panel explica cómo funciona la reproducción y cómo recuperarla."
          }
        }
      }
    },
    "settings.playback.premium.item1": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe nutzt Spotifys Web Playback SDK in einer versteckten Webansicht. Spotify meldet einen Kontofehler für Nicht-Premium-Konten; das Durchsuchen von Playlists kann weiterhin funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback uses Spotify’s Web Playback SDK in a hidden web view. Spotify reports an account error for non-Premium accounts; playlist browsing may still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción usa el Web Playback SDK de Spotify en una vista web oculta. Spotify informa de un error de cuenta para cuentas sin Premium; explorar listas puede seguir funcionando."
          }
        }
      }
    },
    "settings.playback.premium.item2": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Anmeldung registriert Spotiglass diesen Mac automatisch als Spotify-Connect-Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you sign in, Spotiglass registers this Mac as a Spotify Connect device automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras iniciar sesión, Spotiglass registra este Mac como dispositivo Spotify Connect automáticamente."
          }
        }
      }
    },
    "settings.playback.premium.title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium und Web-Wiedergabe"
          }
