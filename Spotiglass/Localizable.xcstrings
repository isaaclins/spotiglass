    "auth.keychain.missingEntitlement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked Keychain access for Spotiglass—often after reinstalling or changing how the app is signed. Try Connect again, or reinstall Spotiglass from a trusted build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloqueó el acceso al llavero para Spotiglass, a menudo tras reinstalar o cambiar la firma de la app. Prueba Conectar de nuevo o reinstala Spotiglass desde una compilación de confianza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Schlüsselbund-Zugriff für Spotiglass blockiert — oft nach Neuinstallation oder geänderter Signatur. Versuche erneut Verbinden oder installiere Spotiglass aus einer vertrauenswürdigen Version neu."
          }
        }
      }
    },
    "auth.keychain.interactionNotAllowed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain access isn’t allowed right now. Unlock your Mac, wait a moment, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al llavero no está permitido ahora mismo. Desbloquea tu Mac, espera un momento e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Zugriff ist gerade nicht erlaubt. Entsperre deinen Mac, warte einen Moment und versuche es erneut."
          }
        }
      }
    },
    "auth.keychain.authFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain verification failed. Try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la verificación del llavero. Inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Verifizierung fehlgeschlagen. Versuche es erneut oder trenne und verbinde Spotify erneut."
          }
        }
      }
    },
    "auth.keychain.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved sign-in data conflicted with an existing Keychain entry. Disconnect, then connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de inicio de sesión guardados entraron en conflicto con una entrada existente del llavero. Desconéctate y vuelve a conectar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Anmeldedaten kollidierten mit einem vorhandenen Schlüsselbund-Eintrag. Trenne die Verbindung und verbinde dich erneut."
          }
        }
      }
    },
    "auth.keychain.readOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain is read-only. Check disk space and permissions, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero es de solo lectura. Comprueba el espacio en disco y los permisos, e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund ist schreibgeschützt. Prüfe Speicherplatz und Berechtigungen und versuche es erneut."
          }
        }
      }
    },
    "auth.keychain.notAvailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain is not available. Restart your Mac and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no está disponible. Reinicia tu Mac e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund ist nicht verfügbar. Starte deinen Mac neu und versuche es erneut."
          }
        }
      }
    },
    "auth.keychain.io": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read or write sign-in data (Keychain I/O error). Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer ni escribir los datos de inicio de sesión (error de E/S del llavero). Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten konnten nicht gelesen oder geschrieben werden (Schlüsselbund-E/A-Fehler). Versuche es erneut."
          }
        }
      }
    },
    "auth.keychain.param": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain rejected the request. Disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero rechazó la solicitud. Desconéctate y vuelve a conectar Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund hat die Anfrage abgelehnt. Trenne die Verbindung und verbinde Spotify erneut."
          }
        }
      }
    },
    "auth.keychain.allocate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough memory to use Keychain. Close other apps and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay memoria suficiente para usar el llavero. Cierra otras apps e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicher für den Schlüsselbund. Schließe andere Apps und versuche es erneut."
          }
        }
      }
    },
    "auth.keychain.decode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not decode Keychain data. Disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron decodificar los datos del llavero. Desconéctate y vuelve a conectar Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Daten konnten nicht dekodiert werden. Trenne die Verbindung und verbinde Spotify erneut."
          }
        }
      }
    },
    "auth.keychain.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access saved Spotify sign-in data (security error %lld)%@. If this keeps happening, note this code when reporting the issue. Try Disconnect, then Connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a los datos guardados de inicio de sesión de Spotify (error de seguridad %lld)%@. Si sigue ocurriendo, anota este código al informar del problema. Prueba Desconectar y luego Conectar de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Spotify-Anmeldedaten konnten nicht gelesen werden (Sicherheitsfehler %lld)%@. Wenn das weiterhin passiert, notiere diesen Code bei der Fehlermeldung. Versuche Trennen und dann erneut Verbinden."
          }
        }
      }
    },
