    "settings.appearance.colorScheme.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows macOS. Light and Dark apply only to Spotiglass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue macOS. Claro y Oscuro se aplican solo a Spotiglass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System folgt macOS. Hell und Dunkel gelten nur für Spotiglass."
          }
        }
      }
    },
    "settings.appearance.commandPalette": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command palette"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paleta de comandos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehls-Palette"
          }
        }
      }
    },
    "settings.appearance.backdropBlur": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blur window behind palette"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfocar ventana detrás de la paleta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster hinter Palette unscharf machen"
          }
        }
      }
    },
    "settings.appearance.backdropBlur.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the rest of the window is slightly blurred while the palette is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, el resto de la ventana se desenfoca ligeramente mientras la paleta está abierta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, wird der Rest des Fensters leicht unscharf, solange die Palette geöffnet ist."
          }
        }
      }
    },
    "settings.playback.premium.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium and Web Playback"
