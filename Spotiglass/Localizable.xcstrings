    "Add to playlist": {
      "comment": "A menu item that adds tracks to a playlist.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to playlist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a la lista"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Playlist hinzufügen"
          }
        }
      }
    },
    "Create a new playlist with %lld track%@ added.": {
      "comment": "The message in the alert that appears when the user creates a playlist with no tracks.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new playlist with %1$lld track%2$@ added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una nueva lista con %1$lld canción%2$@ añadida(s)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Playlist mit %1$lld Song%2$@ erstellen."
          }
        }
      }
    },
    "Create an empty playlist in your Spotify library.": {
      "comment": "The body of a message that appears when a user creates a playlist with no tracks.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an empty playlist in your Spotify library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una lista vacía en tu biblioteca de Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine leere Playlist in deiner Spotify-Bibliothek."
          }
        }
      }
    },
    "Move to playlist": {
      "comment": "A menu that lets the user move tracks to a playlist.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to playlist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover a la lista"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Playlist verschieben"
          }
        }
      }
    },
