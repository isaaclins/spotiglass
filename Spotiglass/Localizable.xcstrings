    "auth.error.cancelled": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wurde abgebrochen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud fue cancelada. Inténtalo de nuevo."
          }
        }
      }
    },
    "auth.error.decode": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify hat eine Antwort zurückgegeben, die Spotiglass nicht lesen konnte. Prüfe deine Verbindung, versuche es erneut oder trenne und verbinde Spotify erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify returned a response Spotiglass could not read. Check your connection, try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify devolvió una respuesta que Spotiglass no pudo leer. Comprueba tu conexión, inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        }
      }
    },
    "auth.error.dns": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify konnte nicht erreicht werden. Prüfe dein Netzwerk und die DNS-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Spotify. Check your network and DNS settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con Spotify. Comprueba tu red y la configuración DNS."
          }
        }
      }
    },
    "auth.error.generic": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Prüfe deine Verbindung, versuche es erneut oder trenne und verbinde Spotify erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Check your connection, try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Comprueba tu conexión, inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        }
      }
    },
    "auth.error.network": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu Spotify fehlgeschlagen. Prüfe dein Netzwerk und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to Spotify. Check your network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Spotify. Comprueba tu red e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.error.offline": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe dein Netzwerk und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que estás sin conexión. Comprueba tu red e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.error.timeout": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu Spotify ist abgelaufen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to Spotify timed out. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con Spotify agotó el tiempo de espera. Inténtalo de nuevo."
          }
        }
      }
    },
    "auth.error.tls": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Verbindung zu Spotify konnte nicht hergestellt werden. Prüfe dein Netzwerk oder VPN und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not establish a secure connection to Spotify. Check your network or VPN, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer una conexión segura con Spotify. Comprueba tu red o VPN e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.insufficientScope.message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihrer aktuellen Spotify-Sitzung fehlen Berechtigungen für Playlists oder Lieblingssongs. Trennen Sie die Verbindung und verbinden Sie sich erneut, um sie wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current Spotify session is missing playlist or Liked Songs permissions. Disconnect and connect again to restore them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A tu sesión de Spotify actual le faltan permisos de listas o de Tus me gusta. Desconecta y vuelve a conectar para restaurarlos."
          }
        }
      }
    },
    "auth.keychain.allocate": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicher für den Schlüsselbund. Schliesse andere Apps und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough memory to use Keychain. Close other apps and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay memoria suficiente para usar el llavero. Cierra otras apps e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.keychain.authFailed": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Verifizierung fehlgeschlagen. Versuche es erneut oder trenne und verbinde Spotify erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain verification failed. Try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la verificación del llavero. Inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        }
      }
    },
    "auth.keychain.decode": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Daten konnten nicht dekodiert werden. Trenne die Verbindung und verbinde Spotify erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not decode Keychain data. Disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron decodificar los datos del llavero. Desconéctate y vuelve a conectar Spotify."
          }
        }
      }
    },
    "auth.keychain.duplicate": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Anmeldedaten kollidierten mit einem vorhandenen Schlüsselbund-Eintrag. Trenne die Verbindung und verbinde dich erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved sign-in data conflicted with an existing Keychain entry. Disconnect, then connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de inicio de sesión guardados entraron en conflicto con una entrada existente del llavero. Desconéctate y vuelve a conectar."
          }
        }
      }
    },
    "auth.keychain.generic": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Spotify-Anmeldedaten konnten nicht gelesen werden (Sicherheitsfehler %lld)%@. Wenn das weiterhin passiert, notiere diesen Code bei der Fehlermeldung. Versuche Trennen und dann erneut Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not access saved Spotify sign-in data (security error %lld)%@. If this keeps happening, note this code when reporting the issue. Try Disconnect, then Connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo acceder a los datos guardados de inicio de sesión de Spotify (error de seguridad %lld)%@. Si sigue ocurriendo, anota este código al informar del problema. Prueba Desconectar y luego Conectar de nuevo."
          }
        }
      }
    },
    "auth.keychain.interactionNotAllowed": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund-Zugriff ist gerade nicht erlaubt. Entsperre deinen Mac, warte einen Moment und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain access isn’t allowed right now. Unlock your Mac, wait a moment, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al llavero no está permitido ahora mismo. Desbloquea tu Mac, espera un momento e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.keychain.io": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten konnten nicht gelesen oder geschrieben werden (Schlüsselbund-E/A-Fehler). Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read or write sign-in data (Keychain I/O error). Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer ni escribir los datos de inicio de sesión (error de E/S del llavero). Inténtalo de nuevo."
          }
        }
      }
    },
    "auth.keychain.missingEntitlement": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Schlüsselbund-Zugriff für Spotiglass blockiert, oft nach Neuinstallation oder geänderter Signatur. Versuche erneut Verbinden oder installiere Spotiglass aus einer vertrauenswürdigen Version neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked Keychain access for Spotiglass, often after reinstalling or changing how the app is signed. Try Connect again, or reinstall Spotiglass from a trusted build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloqueó el acceso al llavero para Spotiglass, a menudo tras reinstalar o cambiar la firma de la app. Prueba Conectar de nuevo o reinstala Spotiglass desde una compilación de confianza."
          }
        }
      }
    },
    "auth.keychain.notAvailable": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund ist nicht verfügbar. Starte deinen Mac neu und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain is not available. Restart your Mac and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no está disponible. Reinicia tu Mac e inténtalo de nuevo."
          }
        }
      }
    },
    "auth.keychain.param": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüsselbund hat die Anfrage abgelehnt. Trenne die Verbindung und verbinde Spotify erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain rejected the request. Disconnect and connect Spotify again."
