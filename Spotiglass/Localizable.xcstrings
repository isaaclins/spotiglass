    "auth.error.decode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify returned a response Spotiglass could not read. Check your connection, try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify devolvió una respuesta que Spotiglass no pudo leer. Comprueba tu conexión, inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify hat eine Antwort zurückgegeben, die Spotiglass nicht lesen konnte. Prüfe deine Verbindung, versuche es erneut oder trenne und verbinde Spotify erneut."
          }
        }
      }
    },
    "auth.error.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que estás sin conexión. Comprueba tu red e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe dein Netzwerk und versuche es erneut."
          }
        }
      }
    },
    "auth.error.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to Spotify timed out. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con Spotify agotó el tiempo de espera. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zu Spotify ist abgelaufen. Versuche es erneut."
          }
        }
      }
    },
    "auth.error.dns": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Spotify. Check your network and DNS settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con Spotify. Comprueba tu red y la configuración DNS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify konnte nicht erreicht werden. Prüfe dein Netzwerk und die DNS-Einstellungen."
          }
        }
      }
    },
    "auth.error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to Spotify. Check your network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Spotify. Comprueba tu red e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu Spotify fehlgeschlagen. Prüfe dein Netzwerk und versuche es erneut."
          }
        }
      }
    },
    "auth.error.tls": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not establish a secure connection to Spotify. Check your network or VPN, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer una conexión segura con Spotify. Comprueba tu red o VPN e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Verbindung zu Spotify konnte nicht hergestellt werden. Prüfe dein Netzwerk oder VPN und versuche es erneut."
          }
        }
      }
    },
    "auth.error.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud fue cancelada. Inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage wurde abgebrochen. Versuche es erneut."
          }
        }
      }
    },
    "auth.error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Check your connection, try again, or disconnect and connect Spotify again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal. Comprueba tu conexión, inténtalo de nuevo o desconéctate y vuelve a conectar Spotify."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
