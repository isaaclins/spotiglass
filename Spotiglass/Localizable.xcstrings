    "auth.cancel.hint": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet das Warten auf die Browser-Anmeldung und kehrt zum Willkommensbildschirm zurück."
          }
