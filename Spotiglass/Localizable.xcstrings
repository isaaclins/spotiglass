    "queue.shuffle.on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuffle on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aleatorio activado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zufallswiedergabe ein"
